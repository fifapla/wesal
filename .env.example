PORT=3000
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/wesal
JWT_SECRET=change-me-to-a-long-random-string
# نص رسالة تأكيد التفعيل (اختياري)
ACTIVATION_MSG=
# رقم استقبال واتساب بالصيغة الدولية بدون + وبدون صفر (مثال: 201012345678)
WA_NUMBER=20XXXXXXXXXX

# ===== إشعارات الأدمن (اختر واحدة أو أكتر، وما تحتاجش تملأ الباقي) =====
# تليجرام: اعمل بوت من @BotFather وخد التوكن، وابعتله أي رسالة، وافتح https://api.telegram.org/bot<TOKEN>/getUpdates وخد chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# بريد إلكتروني (SMTP) مثال جيميل: smtp.gmail.com / 587 / App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=
# واتساب Cloud API (اختياري): للإشعارات التلقائية للأدمن وللمستخدم
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_ID=
ADMIN_WA=
WA_TEMPLATE_ACTIVATED=
